# =============================================
# SanSuite — Environment Variables Template
# Copy this to .env and fill in your values
# =============================================

# ----- APPLICATION -----
NODE_ENV=production
PORT=5000

# ----- SECURITY -----
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars

# ----- DATABASE (MySQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=sansuite

# Connection pool per server instance.
# For auto-scaling: set low (3-5). For single server: 10-20 is fine.
DB_CONNECTION_LIMIT=5
DB_QUEUE_LIMIT=0

# ----- REDIS (optional but recommended for multi-server) -----
# Leave blank for single-server deployments (uses in-memory fallback).
# For production: use Upstash, Redis Cloud, or AWS ElastiCache.
# Format: redis://default:password@host:port
# Format (TLS): rediss://default:password@host:port
REDIS_URL=

# ----- AWS S3 FILE STORAGE (optional) -----
# Leave blank to use local disk storage (./uploads/).
# Required for multi-server / auto-scaling deployments.
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
# Optional: CloudFront CDN URL for faster file delivery
AWS_CLOUDFRONT_URL=

# ----- CORS -----
# Comma-separated list of allowed frontend origins (in addition to localhost).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----- EMAIL (Nodemailer / SMTP) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=SanSuite <noreply@yourdomain.com>

# ----- COMPANIES HOUSE API -----
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key

# ----- STRIPE (if using Stripe gateway) -----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# 1. OpenSanctions (Open Source & Free Open Data Global PEP & Sanctions)
OPENSANCTIONS_API_URL=https://api.opensanctions.org
OPENSANCTIONS_API_KEY=
