le>\n\n\t<hr />\t\n\t\t\n\n\t\t<p class=\"article-vote\" id=\"voting-container\" \n\t\t\t\t\t\t\t\t\t\t\tdata-user-id=\"\" \n\t\t\t\t\t\t\t\t\t\t\tdata-article-id=\"9000272819\"\n\t\t\t\t\t\t\t\t\t\t\tdata-language=\"en\">\n\t\t\t\t\t\t\t\t\t\tDid you find it helpful?<span data-href=\"/support/solutions/articles/9000272819/thumbs_up\" class=\"vote-up a-link\" id=\"article_thumbs_up\" \n\t\t\t\t\t\t\t\t\tdata-remote=\"true\" data-method=\"put\" data-update=\"#voting-container\" \n\t\t\t\t\t\t\t\t\tdata-user-id=\"\"\n\t\t\t\t\t\t\t\t\tdata-article-id=\"9000272819\"\n\t\t\t\t\t\t\t\t\tdata-language=\"en\"\n\t\t\t\t\t\t\t\t\tdata-update-with-message=\"Glad we could be helpful. Thanks for the feedback.\">\n\t\t\t\t\t\t\t\tYes</span><span class=\"vote-down-container\"><span data-href=\"/support/solutions/articles/9000272819/thumbs_down\" class=\"vote-down a-link\" id=\"article_thumbs_down\" \n\t\t\t\t\t\t\t\t\tdata-remote=\"true\" data-method=\"put\" data-update=\"#vote-feedback-form\" \n\t\t\t\t\t\t\t\t\tdata-user-id=\"\"\n\t\t\t\t\t\t\t\t\tdata-article-id=\"9000272819\"\n\t\t\t\t\t\t\t\t\tdata-language=\"en\"\n\t\t\t\t\t\t\t\t\tdata-hide-dom=\"#voting-container\" data-show-dom=\"#vote-feedback-container\">\n\t\t\t\t\t\t\t\tNo</span></span></p><a class=\"hide a-link\" id=\"vote-feedback-form-link\" data-hide-dom=\"#vote-feedback-form-link\" data-show-dom=\"#vote-feedback-container\">Send feedback</a><div id=\"vote-feedback-container\"class=\"hide\">\t<div class=\"lead\">Sorry we couldn't be helpful. Help us improve this article with your feedback.</div>\t<div id=\"vote-feedback-form\">\t\t<div class=\"sloading loading-small loading-block\"></div>\t</div></div>\n\t\t\n"
